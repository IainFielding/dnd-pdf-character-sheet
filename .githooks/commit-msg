#!/bin/sh
#
# .githooks/commit-msg — rejects commit messages carrying AI-agent attribution.
#
# Enable with: git config core.hooksPath .githooks
#
# Targets attribution constructs (trailers, tool sign-offs, bot addresses) rather than
# casual mentions, so ordinary prose such as
#   "Restore cursor styles to locked document sheets."
#   "Fix duplicate warnings being generated by _computeArmorClass"
# is not blocked.

MSG_FILE="$1"

AI_ATTRIBUTION='(^[[:space:]]*Co-[Aa]uthored-[Bb]y:.*(claude|anthropic|copilot|chatgpt|openai|gpt-[0-9]|gemini|devin|cursor|codeium|windsurf|tabnine|\[bot\]))|(noreply@(anthropic|openai)\.com)|(Generated with .*(Claude|Copilot|Cursor|Codex|Gemini|ChatGPT))|(Automated .* generated by .*AI)|(generated by [A-Za-z]*AI\b)|(🤖)'

# Git runs this hook on the raw editor buffer, before comment lines are stripped and — with
# `git commit -v` — with the whole diff below the scissors line. Neither ends up in the commit,
# so neither is scanned; otherwise a diff touching this very file would trip its own pattern.
MSG=$(sed -e '/^# -\{24\} >8 -\{24\}$/,$d' -e '/^#/d' "$MSG_FILE")

if printf '%s\n' "$MSG" | grep -qEi "$AI_ATTRIBUTION"; then
  echo "-------------------------------------------------------------------" >&2
  echo "commit-msg: AI-agent attribution detected in your commit message." >&2
  echo "" >&2
  echo "Offending line(s):" >&2
  printf '%s\n' "$MSG" | grep -Ei "$AI_ATTRIBUTION" | sed 's/^/    /' >&2
  echo "" >&2
  echo "This project does not carry AI tool attribution in commit history." >&2
  echo "Please remove the line(s) above and commit again." >&2
  echo "-------------------------------------------------------------------" >&2
  exit 1
fi

exit 0
